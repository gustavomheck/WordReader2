<Window x:Class="WordReaderV2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Word Reader"
        Width="1000"
        Height="650"
        MinWidth="700"
        MinHeight="450"
        Background="#09090B"
        Foreground="#F4F4F5"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="Foreground" Value="#FAFAFA" />
            <Setter Property="BorderBrush" Value="#52525B" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Grid Margin="42">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Command="{Binding OpenBookCommand}" Content="Abrir EPUB" />
            <StackPanel>
                <TextBlock Text="{Binding BookTitle}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding CurrentChapterTitle}" Foreground="#A1A1AA" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid VerticalAlignment="Center" Height="180">
                <Border Height="3" VerticalAlignment="Top" Background="#27272A" />
                <Border Height="3" VerticalAlignment="Bottom" Background="#27272A" />
                <Border Width="3" Height="25" VerticalAlignment="Top" HorizontalAlignment="Center" Background="#27272A" />
                <Border Width="3" Height="25" VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#27272A" />
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding CurrentWordPrefix}" HorizontalAlignment="Right" FontFamily="Georgia" FontSize="60" />
                    <TextBlock Grid.Column="1" Text="{Binding FocalLetter}" FontFamily="Georgia" FontSize="60" Foreground="#EF4444" />
                    <TextBlock Grid.Column="2" Text="{Binding CurrentWordSuffix}" HorizontalAlignment="Left" FontFamily="Georgia" FontSize="60" />
                </Grid>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" HorizontalAlignment="Center" Foreground="#A1A1AA" />
        </Grid>

        <StackPanel Grid.Row="2">
            <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding BookProgress, Mode=OneWay}" Foreground="#EF4444" Background="#27272A" />
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Velocidade" Foreground="#A1A1AA" />
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="180" Minimum="50" Maximum="1200" Value="{Binding WordsPerMinute, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding WordsPerMinute, Mode=OneWay, StringFormat={}{0} wpm}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding CanSelectChapter, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Capítulo" Foreground="#A1A1AA" />
                        <ComboBox Width="250"
                                  DisplayMemberPath="Title"
                                  ItemsSource="{Binding Chapters}"
                                  SelectedItem="{Binding SelectedChapter, Mode=TwoWay}"
                                  Background="#27272A"
                                  Foreground="#FAFAFA"
                                  BorderBrush="#52525B" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding ToggleReadingCommand}" Content="{Binding ReadingButtonText}" MinWidth="130" />
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding RemainingChapterTime, Mode=OneWay, StringFormat=Tempo no capítulo: {0}}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding BookProgressText, Mode=OneWay}" Foreground="#A1A1AA" HorizontalAlignment="Right" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>